* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  height: 100%;
  font-family: "Segoe UI", Tahoma, sans-serif;
}

body {
  background-color: #e7e7e7;
  color: #1a2230;
  overflow: hidden;
}

.page-frame {
  width: 100%;
}

.browser-window {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f9f9f9;
}

.browser-header {
  flex-shrink: 0;
  background-color: #111f32;
  color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 40px;
}

.brand {
  font-size: 13px;
  font-weight: bold;
  letter-spacing: 1px;
  white-space: nowrap;
}

.nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 12px;
}

.nav a {
  color: white;
  text-decoration: none;
}

.hero {
  flex: 1;
  min-height: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url("image1.webp");
  background-position: center;
  background-size: cover;
  filter: brightness(45%);
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 700px;
  text-align: center;
}

.hero-copy h1 {
  margin: 0;
  font-size: 64px;
  font-weight: bold;
  line-height: 1.2;
}

.hero-copy p {
  margin: 10px 0 0;
  font-size: 20px;
}

.card-grid {
  position: absolute;
  top: 24px;
  right: 40px;
  bottom: 24px;
  left: 40px;
}


.card {
  position: absolute;
  z-index: 2;
  width: 300px;
  padding: 22px;
  background-color: #101b2c;
  border: 1px solid #536071;
  border-radius: 12px;
  color: white;
}

.card-top-left {
  top: 0;
  left: 0;
}

.card-top-right {
  top: 0;
  right: 0;
}

.card-bottom-left {
  bottom: 0;
  left: 0;
}

.card-bottom-right {
  right: 0;
  bottom: 0;
}

.card h2 {
  margin: 0 0 8px;
  font-size: 19px;
}

.card p {
  margin: 0;
  font-size: 16px;
  line-height: 1.5;
}

.nav a {
  color: white;
  text-decoration: none;
}
